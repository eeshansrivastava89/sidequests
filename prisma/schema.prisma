generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            String    @id @default(cuid())
  name          String
  pathHash      String    @unique
  pathDisplay   String
  pinned        Boolean   @default(false)
  lastTouchedAt DateTime?
  snoozedUntil  DateTime?    // When snooze expires (null = not snoozed)
  archivedNote  String?       // Retirement note when archived
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  prunedAt      DateTime?

  scan           Scan?
  derived        Derived?
  llm            Llm?
  override       Override?
  metadata       Metadata?
  github         GitHub?
  activity       Activity[]
  weeklyFocuses  WeeklyFocus[]
  dismissedAlerts DismissedAlert[]
}

model Scan {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rawJson     String   // Full scan output as JSON
  rawJsonHash String?  // SHA-256 hash of rawJson for change detection
  metaJson    String?  // Key-value pairs surfaced to UI (extensible, no migration needed)
  scannedAt   DateTime @default(now())
}

model Derived {
  id                 String    @id @default(cuid())
  projectId          String    @unique
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusAuto         String    // active, paused, stale, archived
  healthScoreAuto    Int
  hygieneScoreAuto   Int       @default(0)
  momentumScoreAuto  Int       @default(0)
  scoreBreakdownJson String    @default("{}")
  derivedJson        String    // Full derived output as JSON (tags, etc.)
  isDirty            Boolean   @default(false)
  dirtyFileCount     Int       @default(0)
  ahead              Int       @default(0)
  behind             Int       @default(0)
  framework          String?
  branchName         String?
  lastCommitDate     DateTime?
  locEstimate        Int       @default(0)
  locCode            Int       @default(0)
  locDocs            Int       @default(0)
  locGenerated       Int       @default(0)
  weekCommits        Int       @default(0)   // Commits in last 7 days
  monthCommits       Int       @default(0)   // Commits in last 30 days
  quarterCommits    Int       @default(0)   // Commits in last 90 days
}

model Llm {
  id                     String    @id @default(cuid())
  projectId              String    @unique
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Phase 53W: new actionable fields
  summary                String?
  nextAction             String?
  llmStatus              String?   // LlmStatus: building|shipping|maintaining|blocked|stale|idea
  statusReason           String?
  risksJson              String?   // deprecated — use insightsJson (kept as fallback)
  tagsJson               String?   // JSON array
  recommendationsJson    String?   // deprecated — use insightsJson (kept as fallback)
  insightsJson           String?   // JSON array — consolidated insights
  framework              String?
  primaryLanguage        String?
  // Deprecated (kept for rollback safety — summary supersedes purpose)
  purpose                String?
  llmError               String?   // Last enrichment error message, null on success
  extrasJson             String?   // Extra LLM output fields (extensible, no migration needed)
  generatedAt            DateTime  @default(now())
}

model Override {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusOverride  String?
  purposeOverride String?
  tagsOverride    String?  // JSON array
  notesOverride   String?
  updatedAt       DateTime @updatedAt
}

model Metadata {
  id             String  @id @default(cuid())
  projectId      String  @unique
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal           String?
  audience       String?
  successMetrics String?
  nextAction     String?
  publishTarget  String?
}

model GitHub {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openIssues      Int      @default(0)
  openPrs         Int      @default(0)
  ciStatus        String   @default("none")
  issuesJson      String?
  prsJson         String?
  repoVisibility  String   @default("not-on-github")
  fetchedAt       DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // e.g. "scan", "override", "llm", "metadata"
  payloadJson String?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

model WeeklyFocus {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goal         String   // What you want to accomplish this week
  completed   Boolean  @default(false)
  weekStart    DateTime // Monday 00:00 of the week
  createdAt    DateTime @default(now())

  @@index([weekStart])
}

model DismissedAlert {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alertType   String   // e.g. "git-urgent", "git-warning", "issue", "stale-decision"
  dismissedAt DateTime @default(now())

  @@unique([projectId, alertType])
}

model UserPreference {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "notification.quietHours", "staleness.threshold"
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model PortfolioAnalysis {
  id          String   @id @default(cuid())
  resultJson  String   // Full portfolio analysis as JSON
  generatedAt DateTime @default(now())
}

model UserVisit {
  id           String   @id @default(cuid())
  key          String   @unique // "lastVisit"
  snapshotJson String  // Serialized MergedProject[] at last visit
  updatedAt    DateTime @updatedAt
}
